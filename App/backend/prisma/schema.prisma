generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//
// ===============================
// ENUMS
// ===============================
//

enum TipoOrganismo {
  Planta
  Hongo
}

//
// ===============================
// MODELOS BASE
// ===============================
//

model Sitios {
  id                     String       @id @default(uuid()) @db.Char(36)
  Nombre                 String?      @db.VarChar(100)
  EsAreaProtegida        Boolean?     @db.TinyInt
  NombreAreaProtegida    String?      @db.VarChar(100)
  ReferenciasAdicionales String?      @db.Text

  // RELACIONES
  Colectas               Colectas[]
}

model Coordenadas {
  id        String       @id @default(uuid()) @db.Char(36)
  Latitud   Decimal?     @db.Decimal(9, 6)
  Longitud  Decimal?     @db.Decimal(9, 6)
  Altitud   Int?

  // RELACIONES
  Colectas  Colectas[]
}

model Organismos {
  id       String          @id @default(uuid()) @db.Char(36)
  Tipo     TipoOrganismo
  Reino    String?         @db.VarChar(50)
  Filo     String?         @db.VarChar(50)
  Clase    String?         @db.VarChar(50)
  Orden    String?         @db.VarChar(50)
  Familia  String?         @db.VarChar(50)
  Genero   String?         @db.VarChar(50)
  Especie  String?         @db.VarChar(50)

  // RELACIONES
  Hongo        Hongos?
  Colectas     Colectas[]     @relation("PlantaFromOrganismo")
  Aislamientos Aislamientos[]
}

model Hongos {
  id                        String        @id @db.Char(36)
  MetodoIdentificacion      String?       @db.Text
  CodigoAccesoGenBank       String?       @db.VarChar(30)
  IdentificadorResponsable  String?       @db.VarChar(100)

  // RELACIONES
  Organismo   Organismos     @relation(fields: [id], references: [id])
  Marcadores  Marcadores[]
}

//
// ===============================
// COLECTAS Y AISLAMIENTOS
// ===============================
//

model Colectas {
  id                String        @id @default(uuid()) @db.Char(36)
  idHeredado        String?       @unique @db.VarChar(100)
  Colector          String?       @db.VarChar(100)
  Fecha             DateTime?     @db.Date
  Temperatura       Decimal?      @db.Decimal(5, 2)
  Humedad           Decimal?      @db.Decimal(5, 2)
  pH                Decimal?      @db.Decimal(4, 2)
  idSitio           String?       @db.Char(36)
  TieneCoordenadas  Boolean       @db.TinyInt
  idCoordenadas     String?       @db.Char(36)
  ContienePlanta    Boolean       @db.TinyInt
  idPlanta          String?       @db.Char(36)

  // RELACIONES
  Sitio        Sitios?       @relation(fields: [idSitio], references: [id])
  Coordenadas  Coordenadas?  @relation(fields: [idCoordenadas], references: [id])
  Planta       Organismos?   @relation("PlantaFromOrganismo", fields: [idPlanta], references: [id])

  Aislamientos Aislamientos[]
}

model Aislamientos {
  id                 String        @id @default(uuid()) @db.Char(36)
  idHeredado         String        @unique @db.VarChar(100)
  AisladoDePlanta    Boolean       @db.TinyInt
  ParteDePlanta      String?       @db.VarChar(50)
  FechaAislamiento   DateTime?     @db.Date
  FechaSalida        DateTime?     @db.Date
  IdAnalisisMolecular String?      @db.VarChar(100)
  MedioCultivo       String?       @db.VarChar(100)
  MetodoSiembra      String?       @db.VarChar(100)
  Estado             String?       @db.VarChar(50)
  Comentarios        String?       @db.Text
  CantidadExistencias Int?
  EstaEnColeccion     Boolean      @default(false) @db.TinyInt
  idColecta          String?       @db.Char(36)
  idOrganismo        String?       @db.Char(36)

  // RELACIONES
  Colecta      Colectas?           @relation(fields: [idColecta], references: [id])
  Organismo    Organismos?         @relation(fields: [idOrganismo], references: [id])

  Ensayos      EnsayosBiologicos[]
  Morfologias  Morfologias[]
}

//
// ===============================
// ANEXOS DE AISLAMIENTOS
// ===============================
//

model EnsayosBiologicos {
  id            String     @id @default(uuid()) @db.Char(36)
  idAislamiento String     @db.Char(36)
  Tipo          String     @db.VarChar(50)
  Resultado     String?    @db.Text

  // RELACIONES
  Aislamiento   Aislamientos @relation(fields: [idAislamiento], references: [id], onDelete: Cascade)
}

model Morfologias {
  id                    String     @id @default(uuid()) @db.Char(36)
  idAislamiento         String     @db.Char(36)
  Forma                 String?    @db.VarChar(50)
  FormaBorde            String?    @db.VarChar(50)
  ColorAnverso          String?    @db.VarChar(50)
  ColorReverso          String?    @db.VarChar(50)
  ColorBorde            String?    @db.VarChar(50)
  TieneMicelioAereo     Boolean?   @db.TinyInt
  DensidadMicelioAereo  String?    @db.VarChar(50)
  TipoCrecimiento       String?    @db.VarChar(50)
  TipoHifa              String?    @db.VarChar(50)
  TieneSecreciones      Boolean?   @db.TinyInt
  Observaciones         String?    @db.Text

  // RELACIONES
  Aislamiento Aislamientos @relation(fields: [idAislamiento], references: [id], onDelete: Cascade)
}

//
// ===============================
// MARCADORES MOLECULARES
// ===============================
//

model Marcadores {
  id        String     @id @default(uuid()) @db.Char(36)
  idHongo   String     @db.Char(36)
  Tipo      String     @db.VarChar(50)
  Secuencia String?    @db.Text

  // RELACIONES
  Hongo     Hongos     @relation(fields: [idHongo], references: [id], onDelete: Cascade)
}
