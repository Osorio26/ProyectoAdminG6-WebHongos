generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

//
// ===============================
// ENUMS
// ===============================
//

// SQLite handles enums as strings.

//
// ===============================
// MODELOS BASE
// ===============================
//

model Sitios {
  id                     String       @id @default(uuid())
  Nombre                 String?
  EsAreaProtegida        Boolean?
  NombreAreaProtegida    String?
  ReferenciasAdicionales String?

  // RELACIONES
  Colectas               Colectas[]
}

model Coordenadas {
  id        String       @id @default(uuid())
  Latitud   Float?
  Longitud  Float?
  Altitud   Int?

  // RELACIONES
  Colectas  Colectas[]
}

model Organismos {
  id       String          @id @default(uuid())
  Tipo     String
  Reino    String?
  Filo     String?
  Clase    String?
  Orden    String?
  Familia  String?
  Genero   String?
  Especie  String?

  // RELACIONES
  Hongo        Hongos?
  Colectas     Colectas[]     @relation("PlantaFromOrganismo")
  Aislamientos Aislamientos[]
}

model Hongos {
  id                        String        @id
  MetodoIdentificacion      String?
  CodigoAccesoGenBank       String?
  IdentificadorResponsable  String?

  // RELACIONES
  Organismo   Organismos     @relation(fields: [id], references: [id])
  Marcadores  Marcadores[]
  Aislamientos Aislamientos[]
}

//
// ===============================
// COLECTAS Y AISLAMIENTOS
// ===============================
//

model Colectas {
  id                String        @id @default(uuid())
  idHeredado        String?       @unique
  Colector          String?
  Fecha             DateTime?
  Temperatura       Float?
  Humedad           Float?
  pH                Float?
  idSitio           String?
  TieneCoordenadas  Boolean
  idCoordenadas     String?
  ContienePlanta    Boolean
  idPlanta          String?

  // RELACIONES
  Sitio        Sitios?       @relation(fields: [idSitio], references: [id])
  Coordenadas  Coordenadas?  @relation(fields: [idCoordenadas], references: [id])
  Planta       Organismos?   @relation("PlantaFromOrganismo", fields: [idPlanta], references: [id])

  Aislamientos Aislamientos[]
}

model Aislamientos {
  id                 String        @id @default(uuid())
  idHeredado         String        @unique
  AisladoDePlanta    Boolean
  ParteDePlanta      String?
  FechaAislamiento   DateTime?
  FechaSalida        DateTime?
  IdAnalisisMolecular String?
  MedioCultivo       String?
  MetodoSiembra      String?
  Estado             String?
  Comentarios        String?
  CantidadExistencias Int?
  EstaEnColeccion     Boolean      @default(false)
  idColecta          String?
  idOrganismo        String?
  idHongo            String?

  // RELACIONES
  Colecta      Colectas?           @relation(fields: [idColecta], references: [id])
  Organismo    Organismos?         @relation(fields: [idOrganismo], references: [id])
  Hongo        Hongos?             @relation(fields: [idHongo], references: [id])

  EnsayosBiologicos EnsayosBiologicos[]
  Morfologias  Morfologias[]
}

//
// ===============================
// ANEXOS DE AISLAMIENTOS
// ===============================
//

model EnsayosBiologicos {
  id            String     @id @default(uuid())
  idAislamiento String
  Tipo          String
  Resultado     String?

  // RELACIONES
  Aislamiento   Aislamientos @relation(fields: [idAislamiento], references: [id], onDelete: Cascade)
}

model Morfologias {
  id                    String     @id @default(uuid())
  idAislamiento         String
  Forma                 String?
  FormaBorde            String?
  ColorAnverso          String?
  ColorReverso          String?
  ColorBorde            String?
  TieneMicelioAereo     Boolean?
  DensidadMicelioAereo  String?
  TipoCrecimiento       String?
  TipoHifa              String?
  TieneSecreciones      Boolean?
  Observaciones         String?

  // RELACIONES
  Aislamiento Aislamientos @relation(fields: [idAislamiento], references: [id], onDelete: Cascade)
}

//
// ===============================
// MARCADORES MOLECULARES
// ===============================
//

model Marcadores {
  id        String     @id @default(uuid())
  idHongo   String
  Tipo      String
  Secuencia String?

  // RELACIONES
  Hongo     Hongos     @relation(fields: [idHongo], references: [id], onDelete: Cascade)
}
