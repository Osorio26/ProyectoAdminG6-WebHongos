generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

//
// ===============================
// ENUMS
// ===============================
//

// SQLite handles enums as strings.

//
// ===============================
// MODELOS BASE
// ===============================
//

model Sitios {
  id                     String       @id @default(uuid()) @map("Id")
  Nombre                 String?      @map("Nombre")
  EsAreaProtegida        Boolean?     @map("EsAreaProtegida")
  NombreAreaProtegida    String?      @map("NombreAreaProtegida")
  ReferenciasAdicionales String?      @map("ReferenciasAdicionales")

  // RELACIONES
  Colectas               Colectas[]
}

model Coordenadas {
  id        String       @id @default(uuid()) @map("Id")
  Latitud   Float?       @map("Latitud")
  Longitud  Float?       @map("Longitud")
  Altitud   Int?         @map("Altitud")

  // RELACIONES
  Colectas  Colectas[]
}

model Organismos {
  id       String          @id @default(uuid()) @map("Id")
  Tipo     String          @map("Tipo")
  Reino    String?         @map("Reino")
  Filo     String?         @map("Filo")
  Clase    String?         @map("Clase")
  Orden    String?         @map("Orden")
  Familia  String?         @map("Familia")
  Genero   String?         @map("Genero")
  Especie  String?         @map("Especie")

  // RELACIONES
  Hongo        Hongos?
  Colectas     Colectas[]     @relation("PlantaFromOrganismo")
  Aislamientos Aislamientos[]
}

model Hongos {
  id                        String        @id @map("Id")
  MetodoIdentificacion      String?       @map("MetodoIdentificacion")
  CodigoAccesoGenBank       String?       @map("CodigoAccesoGenBank")
  IdentificadorResponsable  String?       @map("IdentificadorResponsable")

  // RELACIONES
  Organismo   Organismos     @relation(fields: [id], references: [id])
  Marcadores  Marcadores[]
  Aislamientos Aislamientos[]
}

//
// ===============================
// COLECTAS Y AISLAMIENTOS
// ===============================
//

model Colectas {
  id                String        @id @default(uuid()) @map("Id")
  idHeredado        String?       @unique @map("IdHeredado")
  Colector          String?       @map("Colector")
  Fecha             String?       @map("Fecha")
  Temperatura       Float?        @map("Temperatura")
  Humedad           Float?        @map("Humedad")
  pH                Float?        @map("pH")
  idSitio           String?       @map("IdSitio")
  TieneCoordenadas  Boolean       @map("TieneCoordenadas")
  idCoordenadas     String?       @map("IdCoordenadas")
  ContienePlanta    Boolean       @map("ContienePlanta")
  idPlanta          String?       @map("IdPlanta")

  // RELACIONES
  Sitio        Sitios?       @relation(fields: [idSitio], references: [id])
  Coordenadas  Coordenadas?  @relation(fields: [idCoordenadas], references: [id])
  Planta       Organismos?   @relation("PlantaFromOrganismo", fields: [idPlanta], references: [id])

  Aislamientos Aislamientos[]
}

model Aislamientos {
  id                 String        @id @default(uuid()) @map("Id")
  idHeredado         String        @unique @map("IdHeredado")
  AisladoDePlanta    Boolean       @map("AisladoDePlanta")
  ParteDePlanta      String?       @map("ParteDePlanta")
  FechaAislamiento   DateTime?     @map("FechaAislamiento")
  FechaSalida        DateTime?     @map("FechaSalida")
  IdAnalisisMolecular String?      @map("IdAnalisisMolecular")
  MedioCultivo       String?       @map("MedioCultivo")
  MetodoSiembra      String?       @map("MetodoSiembra")
  Estado             String?       @map("Estado")
  Comentarios        String?       @map("Comentarios")
  CantidadExistencias Int?         @map("CantidadExistencias")
  EstaEnColeccion     Boolean      @default(false) @map("EstaEnColeccion")
  idColecta          String?       @map("IdColecta")
  idOrganismo        String?       @map("IdOrganismo")
  idHongo            String?       @map("IdHongo")

  // RELACIONES
  Colecta      Colectas?           @relation(fields: [idColecta], references: [id])
  Organismo    Organismos?         @relation(fields: [idOrganismo], references: [id])
  Hongo        Hongos?             @relation(fields: [idHongo], references: [id])

  EnsayosBiologicos EnsayosBiologicos[]
  Morfologias  Morfologias[]
}

//
// ===============================
// ANEXOS DE AISLAMIENTOS
// ===============================
//

model EnsayosBiologicos {
  id            String     @id @default(uuid()) @map("Id")
  idAislamiento String     @map("IdAislamiento")
  Tipo          String     @map("Tipo")
  Resultado     String?    @map("Resultado")

  // RELACIONES
  Aislamiento   Aislamientos @relation(fields: [idAislamiento], references: [id], onDelete: Cascade)
}

model Morfologias {
  id                    String     @id @default(uuid()) @map("Id")
  idAislamiento         String     @map("IdAislamiento")
  Forma                 String?    @map("Forma")
  FormaBorde            String?    @map("FormaBorde")
  ColorAnverso          String?    @map("ColorAnverso")
  ColorReverso          String?    @map("ColorReverso")
  ColorBorde            String?    @map("ColorBorde")
  TieneMicelioAereo     Boolean?   @map("TieneMicelioAereo")
  DensidadMicelioAereo  String?    @map("DensidadMicelioAereo")
  TipoCrecimiento       String?    @map("TipoCrecimiento")
  TipoHifa              String?    @map("TipoHifa")
  TieneSecreciones      Boolean?   @map("TieneSecreciones")
  Observaciones         String?    @map("Observaciones")

  // RELACIONES
  Aislamiento Aislamientos @relation(fields: [idAislamiento], references: [id], onDelete: Cascade)
}

//
// ===============================
// MARCADORES MOLECULARES
// ===============================
//

model Marcadores {
  id        String     @id @default(uuid()) @map("Id")
  idHongo   String     @map("IdHongo")
  Tipo      String     @map("Tipo")
  Secuencia String?    @map("Secuencia")

  // RELACIONES
  Hongo     Hongos     @relation(fields: [idHongo], references: [id], onDelete: Cascade)
}
